CUSTOM_IMAGE=frappe-demo
CUSTOM_TAG=16

# make .env fills in both passwords with random values
DB_PASSWORD=

HTTP_PUBLISH_PORT=8080
SITE_NAME=demo.localhost
AI_MODEL=gemma4:26b
# the context window the agent asks Ollama for: Ollama advises 64K or more for agents; gemma4:26b takes up to 262144
AI_NUM_CTX=65536
# native: the host's own Ollama (on a Mac, the GPU); container: Ollama in Docker, CPU only on a Mac
OLLAMA=native
# must be a 768-dim model: the KB Chunk vector column is VECTOR(768)
EMBED_MODEL=nomic-embed-text

ADMIN_PASSWORD=
